							"mode": "raw",
							"raw": "{\n  \"name\": \"{{villageName}}\",\n  \"bbox\": {\n    \"min_lat\": 21.235,\n    \"min_lon\": 81.285,\n    \"max_lat\": 21.265,\n    \"max_lon\": 81.315\n  }\n}"
