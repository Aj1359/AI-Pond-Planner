				{
					"name": "5. List Candidate Sites",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Returns candidate sites with slope <= 6%', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.candidates.length).to.be.above(0);",
									"    json.candidates.forEach(function(c) {",
									"        pm.expect(c.slope_pct).to.be.at.most(6.0);",
									"        pm.expect(c.suitability_score).to.be.within(0.0, 1.0);",
									"    });",
									"    pm.collectionVariables.set('candidateId', json.candidates[0].id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
