				{
					"name": "7. Estimate Runoff & Frustum Sizing",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Validates 3D Frustum Geometry & Bounds', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.recommended_depth_m).to.be.within(1.5, 4.0);",
									"    pm.expect(json.storage_capacity_m3).to.be.above(0);",
									"    pm.expect(json.top_length_m).to.be.above(json.bottom_length_m);",
									"    pm.expect(json.top_width_m).to.be.above(json.bottom_width_m);",
									"    pm.expect(json.side_slope_ratio).to.eql(1.5);",
									"    pm.expect(json.freeboard_m).to.eql(0.5);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/villages/{{villageName}}/candidates/{{candidateId}}/estimate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "villages", "{{villageName}}", "candidates", "{{candidateId}}", "estimate"]
