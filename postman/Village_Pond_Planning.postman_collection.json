				{
					"name": "8. Get Ranked Recommendations",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Recommendations are sorted descending by rank_score', function () {",
									"    var json = pm.response.json();",
									"    var recs = json.recommendations;",
									"    pm.expect(recs.length).to.be.above(0);",
									"    for (var i = 0; i < recs.length - 1; i++) {",
									"        pm.expect(recs[i].rank_score).to.be.at.least(recs[i+1].rank_score);",
									"    }",
									"});"
								],
								"type": "text/javascript"
