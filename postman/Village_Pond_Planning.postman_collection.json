									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Contains village_id and candidates count', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('village_id');",
									"    pm.expect(json.candidate_count).to.be.at.least(1);",
